@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(alica_engine)
find_dependency(alica_dynamic_loading)
find_dependency(Boost COMPONENTS system filesystem)

include(${CMAKE_CURRENT_LIST_DIR}/alica_simTargets.cmake)

set_and_check(alica_sim_INCLUDE_DIRS "@PACKAGE_INCLUDE_INSTALL_DIR@")
set(alica_sim_LIBRARIES alica_sim)

check_required_components(alica_sim)
